+void ggml_cpu_flash_attn_ext_accumulate(ggml_tensor * dst, float * partials, void * work, bool final_block) {
+    const auto * q = dst->src[0];
+    const int64_t rows = q->ne[1] * q->ne[2];
+    const int64_t dv = dst->ne[0], stride = dv + 2;
+    GGML_ASSERT(q->ne[3] == 1 && dst->src[4] == nullptr && dst->src[2]->type != GGML_TYPE_F16);
+    ggml_compute_params params{};
+    params.ith = 0;
+    params.nth = 1;
+    params.wdata = work;
+    ggml_compute_forward_flash_attn_ext_f16_one_chunk(&params, dst, 0, rows, 0, dst->src[1]->ne[1], partials, stride, true);
+    if (final_block) {
+        for (int64_t row = 0; row < rows; ++row) {
+            float * result = partials + row * stride + 2;
+            const float sum = partials[row * stride + 1];
+            ggml_vec_scale_f32(dv, result, sum == 0 ? 0 : 1.0f / sum);
+            const auto head = row / q->ne[1], token = row % q->ne[1];
+            memcpy(static_cast<char *>(dst->data) + head * dst->nb[1] + token * dst->nb[2], result, dv * sizeof(float));
         }
     }
