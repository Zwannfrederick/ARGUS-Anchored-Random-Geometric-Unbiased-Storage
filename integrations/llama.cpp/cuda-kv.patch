+struct external_custom_op {
+    ggml_custom_op_t marker;
+    ggml_cuda_custom_compute_t compute;
+    ggml_backend_buffer_type_t buffer;
+};
+static std::atomic<const external_custom_op *> external_op{nullptr};
+void ggml_backend_cuda_register_custom_op(ggml_custom_op_t marker, ggml_cuda_custom_compute_t compute,
+                                          ggml_backend_buffer_type_t buffer) {
+    static const external_custom_op registered{marker, compute, buffer};
+    GGML_ASSERT(registered.marker == marker && registered.compute == compute && registered.buffer == buffer);
+    external_op.store(&registered);
+}
+static bool is_external_op(const ggml_tensor * op) {
+    const auto * registered = external_op.load();
+    if (op->op != GGML_OP_CUSTOM || !registered) { return false; }
+    ggml_custom_op_params params;
+    memcpy(&params, op->op_params, sizeof params);
+    return params.fun == registered->marker;
+}
